#include "/Engine/Public/Platform.ush"

// -----------------------------------------------------------------------------
// シェーダーパラメータ定義
// -----------------------------------------------------------------------------
float3 CameraPosition;
float4x4 InvViewProjectionMatrix;
float2 ScreenSize;
float Time;
float4 MyColor;

float3 LightDirection;
float4 LightColor;
int DebugMode;

Texture2D SceneDepthTexture;
SamplerState SceneDepthTextureSampler;

// -----------------------------------------------------------------------------
// 1. ノイズ＆数学関数群
// -----------------------------------------------------------------------------
float hash(float3 p)
{
    p = frac(p * float3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yzx + 33.33);
    return frac((p.x + p.y) * p.z);
}

float3 hash33(float3 p)
{
    p = frac(p * float3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yxz + 33.33);
    return frac((p.xxy + p.yxx) * p.zyx);
}

float GradientNoise(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    float3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);

    float g000 = dot(hash33(i + float3(0, 0, 0)) * 2.0 - 1.0, f - float3(0, 0, 0));
    float g100 = dot(hash33(i + float3(1, 0, 0)) * 2.0 - 1.0, f - float3(1, 0, 0));
    float g010 = dot(hash33(i + float3(0, 1, 0)) * 2.0 - 1.0, f - float3(0, 1, 0));
    float g110 = dot(hash33(i + float3(1, 1, 0)) * 2.0 - 1.0, f - float3(1, 1, 0));
    float g001 = dot(hash33(i + float3(0, 0, 1)) * 2.0 - 1.0, f - float3(0, 0, 1));
    float g101 = dot(hash33(i + float3(1, 0, 1)) * 2.0 - 1.0, f - float3(1, 0, 1));
    float g011 = dot(hash33(i + float3(0, 1, 1)) * 2.0 - 1.0, f - float3(0, 1, 1));
    float g111 = dot(hash33(i + float3(1, 1, 1)) * 2.0 - 1.0, f - float3(1, 1, 1));

    return lerp(
        lerp(lerp(g000, g100, u.x), lerp(g010, g110, u.x), u.y),
        lerp(lerp(g001, g101, u.x), lerp(g011, g111, u.x), u.y),
        u.z
    ) * 0.5 + 0.5;
}

float fbm(float3 p)
{
    float Value = 0.0;
    float Amplitude = 0.5;
    float Frequency = 1.0;
    
    for (int i = 0; i < 5; i++)
    {
        Value += Amplitude * GradientNoise(p * Frequency);
        Frequency *= 2.02;
        Amplitude *= 0.5;
    }
    return saturate(Value);
}

// Phase 関数 (Henyey-Greenstein)
float HenyeyGreenstein(float CosTheta, float g)
{
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * 3.14159265 * pow(1.0 + g2 - 2.0 * g * CosTheta, 1.5));
}

// 再マッピング用ヘルパー関数
float remap(float value, float oldMin, float oldMax, float newMin, float newMax)
{
    return newMin + (saturate((value - oldMin) / (oldMax - oldMin))) * (newMax - newMin);
}

// -----------------------------------------------------------------------------
// 2. 高度＆ノイズディテールによる雲密度計算
// -----------------------------------------------------------------------------
float GetCloudDensity(float3 Pos, float TimeVal)
{
    float MinCloudHeight = 20000.0f; // 200m
    float MaxCloudHeight = 150000.0f; // 1,500m

    if (Pos.z < MinCloudHeight || Pos.z > MaxCloudHeight)
    {
        return 0.0f;
    }

    // 高度マスク: 雲底は比較的シャープに切り揃え、上部は緩やかに消す
    float HeightNormalized = (Pos.z - MinCloudHeight) / (MaxCloudHeight - MinCloudHeight);
    float HeightMask = smoothstep(0.0f, 0.10f, HeightNormalized) * smoothstep(1.0f, 0.60f, HeightNormalized);

    // ★ 1. ベース形状ノイズ（少しスケールを細かくして空全体に散らす）
    float3 BaseNoisePos = Pos * 0.000008f + float3(TimeVal * 0.002f, TimeVal * 0.001f, 0);
    float BaseNoise = fbm(BaseNoisePos);

    // ★ 2. 閾値処理（Remapでメリハリをつける）
    float CloudCoverage = 0.38f; // 散らばり具合（下げるほど空全体に雲が増える）
    float BaseDensity = remap(BaseNoise, CloudCoverage, 1.0f, 0.0f, 1.0f);
    BaseDensity = saturate(BaseDensity);

    if (BaseDensity <= 0.0f)
    {
        return 0.0f;
    }

    // ★ 3. 高周波ディテールノイズによる輪郭の削り取り (Erosion)
    // ノイズスケールを細かく（0.00005f）して雲のフチをもこもこ・シャープにする
    float3 DetailNoisePos = Pos * 0.00005f + float3(TimeVal * 0.008f, 0, 0);
    float DetailNoise = fbm(DetailNoisePos);

    // 密度が低い部分（フチ）ほど強力に削る
    float HighFreqErosion = (1.0f - DetailNoise) * 0.55f;
    float FinalDensity = saturate(BaseDensity - HighFreqErosion);

    return FinalDensity * HeightMask * 4.0f; // 密度倍率を上げて内部を不透明にする
}


// -----------------------------------------------------------------------------
// 3. レイ＆深度ヘルパー関数
// -----------------------------------------------------------------------------
void GenerateRay(float2 InScreenPos, out float3 OutRayOrigin, out float3 OutRayDir)
{
    float2 UV = InScreenPos / ScreenSize;
    float4 NdcPos = float4(UV.x * 2.0f - 1.0f, (1.0f - UV.y) * 2.0f - 1.0f, 1.0f, 1.0f);

    float4 WorldTarget = mul(NdcPos, InvViewProjectionMatrix);
    float3 WorldPos = WorldTarget.xyz / WorldTarget.w;

    OutRayOrigin = CameraPosition;
    OutRayDir = normalize(WorldPos - OutRayOrigin);
}

float GetMaxRayDistance(float2 InScreenPos)
{
    float2 UV = InScreenPos / ScreenSize;
    float DeviceDepth = SceneDepthTexture.SampleLevel(SceneDepthTextureSampler, UV, 0).r;
    float CustomSceneDepth = (1.0f - DeviceDepth) * 100000.0f;

    float MaxDistance = 600000.0f; // 6km
    if (CustomSceneDepth > 0.0f)
    {
        MaxDistance = min(MaxDistance, CustomSceneDepth);
    }
    return MaxDistance;
}

// -----------------------------------------------------------------------------
// 4. ライティング計算（Beer-Lambert ＋ 散乱）
// -----------------------------------------------------------------------------
float3 CalculateLighting(float3 CurrentPos, float3 RayDir, float TimeVal)
{
    float3 LightDirNorm = normalize(-LightDirection);
    float CosTheta = dot(RayDir, LightDirNorm);
    
    // 二重 Henyey-Greenstein（前方に強い光の輪、後方にうっすらとした反射）
    float Phase = lerp(HenyeyGreenstein(CosTheta, 0.6f), HenyeyGreenstein(CosTheta, -0.2f), 0.3f);

    // 太陽光方向へのセルフシャドウ（光の吸収距離のサンプリング）
    float LightStepSize = 2500.0f;
    int LightMaxSteps = 4;
    float LightDensityAccum = 0.0f;

    for (int j = 1; j <= LightMaxSteps; j++)
    {
        float3 LightSamplePos = CurrentPos + LightDirNorm * (j * LightStepSize);
        LightDensityAccum += GetCloudDensity(LightSamplePos, TimeVal);
    }

    // Beer-Lambert の法則による光の減衰 (陰影のメリハリ)
    float LightTransmittance = exp(-LightDensityAccum * 0.8f);
    
    float3 ShadowColor = float3(0.4, 0.45, 0.55); // 暗い下面の影色
    float3 AmbientLight = float3(0.7, 0.8, 0.95); // 空からの環境光

    float3 DirectLight = LightColor.rgb * LightTransmittance * Phase * 2.0f;
    float3 IndirectLight = lerp(ShadowColor, AmbientLight, LightTransmittance);

    return (DirectLight + IndirectLight) * MyColor.rgb;
}

// =============================================================================
// メインピクセルシェーダー
// =============================================================================
void MainPS(
    in float4 InPosition : SV_POSITION,
    out float4 OutColor : SV_Target0)
{
    // 1. レイ生成
    float3 RayOrigin, RayDir;
    GenerateRay(InPosition.xy, RayOrigin, RayDir);

    if (any(isnan(RayDir)) || any(isinf(RayDir)))
    {
        OutColor = float4(0, 0, 0, 0);
        return;
    }

    // 2. 遮蔽距離取得
    float MaxRayDistance = GetMaxRayDistance(InPosition.xy);

    // 3. レイマーチング初期化
    float StepSize = 2000.0f; // 1ステップ 20m
    int MaxSteps = 96;

    float3 FinalColor = float3(0.0, 0.0, 0.0);
    float Transmittance = 1.0f;

    float Dither = hash(float3(InPosition.xy, Time));
    float3 CurrentPos = RayOrigin + RayDir * (StepSize * Dither);

    // 4. レイマーチング・ループ
    for (int i = 0; i < MaxSteps; i++)
    {
        CurrentPos += RayDir * StepSize;

        float DistanceFromOrigin = length(CurrentPos - RayOrigin);
        if (DistanceFromOrigin > MaxRayDistance)
        {
            break;
        }

        float Density = GetCloudDensity(CurrentPos, Time);

        if (Density > 0.001f)
        {
            float3 StepColor = CalculateLighting(CurrentPos, RayDir, Time);

            // 光の吸収と色積算 (Beer-Lambert attenuation)
            float StepExtinction = Density * StepSize * 0.0003f;
            float StepTransmittance = exp(-StepExtinction);
            
            FinalColor += StepColor * Density * Transmittance * StepSize * 0.0003f;
            Transmittance *= StepTransmittance;

            if (Transmittance < 0.01f)
            {
                break;
            }
        }
    }

    float CloudAlpha = saturate(1.0f - Transmittance);
    FinalColor = saturate(FinalColor);

    OutColor = float4(FinalColor, CloudAlpha);
}