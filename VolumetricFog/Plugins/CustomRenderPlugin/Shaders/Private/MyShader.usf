#include "/Engine/Public/Platform.ush"

float3 CameraPosition;
float4x4 InvViewProjectionMatrix;
float2 ScreenSize;
float Time;
float4 MyColor;

float3 LightDirection;
float4 LightColor;
int DebugMode;

// -----------------------------------------------------------------------------
// ノイズ関数
// -----------------------------------------------------------------------------
float hash(float3 p)
{
    p = frac(p * float3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yzx + 33.33);
    return frac((p.x + p.y) * p.z);
}

float noise3D(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);

    return lerp(
        lerp(lerp(hash(i + float3(0, 0, 0)), hash(i + float3(1, 0, 0)), f.x),
             lerp(hash(i + float3(0, 1, 0)), hash(i + float3(1, 1, 0)), f.x), f.y),
        lerp(lerp(hash(i + float3(0, 0, 1)), hash(i + float3(1, 0, 1)), f.x),
             lerp(hash(i + float3(0, 1, 1)), hash(i + float3(1, 1, 1)), f.x), f.y),
        f.z
    );
}

float fbm(float3 p)
{
    float value = 0.0;
    float amplitude = 0.5;
    for (int i = 0; i < 3; i++)
    {
        value += amplitude * noise3D(p);
        p *= 2.0;
        amplitude *= 0.5;
    }
    return value;
}

// -----------------------------------------------------------------------------
// 高度帯モデルによる雲の密度計算
// -----------------------------------------------------------------------------
float GetCloudDensityHighSensitivity(float3 Pos, float TimeVal)
{
    // 地表から 500m (50,000cm) 〜 2,500m (250,000cm) の位置に設定
    float MinCloudHeight = 50000.0f;
    float MaxCloudHeight = 250000.0f;

    if (Pos.z < MinCloudHeight || Pos.z > MaxCloudHeight)
    {
        return 0.0f;
    }

    float HeightNormalized = (Pos.z - MinCloudHeight) / (MaxCloudHeight - MinCloudHeight);
    float HeightMask = sin(HeightNormalized * 3.14159265f);

    float3 NoisePos = Pos * 0.00003f + float3(TimeVal * 0.05f, TimeVal * 0.02f, 0.0f);
    float NoiseValue = fbm(NoisePos);

    float CloudDensity = saturate((NoiseValue - 0.35f) * 3.0f);
    return CloudDensity * HeightMask * 0.2f;
}

float HenyeyGreenstein(float CosTheta, float g)
{
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * 3.14159265 * pow(1.0 + g2 - 2.0 * g * CosTheta, 1.5));
}

// =============================================================================
// メインピクセルシェーダー
// =============================================================================
void MainPS(
    in float4 InPosition : SV_POSITION,
    out float4 OutColor : SV_Target0)
{
    // 1. スクリーン UV (0 ~ 1)
    float2 UV = InPosition.xy / ScreenSize;

    // 2. NDC 座標 (-1 ~ 1)
    // ★ Reversed-Z では Z=1.0 が Near Plane（近平面）となります
    float4 NdcPos = float4(UV.x * 2.0f - 1.0f, (1.0f - UV.y) * 2.0f - 1.0f, 1.0f, 1.0f);

    // 3. ワールド座標ターゲットの復元
    float4 WorldTarget = mul(NdcPos, InvViewProjectionMatrix);
    float3 WorldPos = WorldTarget.xyz / WorldTarget.w;

    // 4. レイの原点と方向
    float3 RayOrigin = CameraPosition;
    float3 RayDir = normalize(WorldPos - RayOrigin);

    // ★ 安全対策：万が一 RayDir に NaN や Inf が混ざった場合に黒画面化を防止
    if (any(isnan(RayDir)) || any(isinf(RayDir)))
    {
        OutColor = float4(0, 0, 0, 0);
        return;
    }

    // 5. ライティング設定
    float3 LightDirNorm = normalize(-LightDirection);
    float CosTheta = dot(RayDir, LightDirNorm);
    float PhaseFunction = HenyeyGreenstein(CosTheta, 0.6);

    float3 ShadowColor = float3(0.15, 0.2, 0.35);
    float3 AmbientLight = float3(0.3, 0.4, 0.5) * 0.8;

    // 6. レイマーチング
    float StepSize = 4000.0; // 1ステップ 40m
    int MaxSteps = 64; // 約 2.5km 先まで検索

    float3 FinalColor = float3(0.0, 0.0, 0.0);
    float Transmittance = 1.0;
    float3 CurrentPos = RayOrigin;

    for (int i = 0; i < MaxSteps; i++)
    {
        CurrentPos += RayDir * StepSize;

        if (CurrentPos.z < -10000.0f)
            continue;

        float Density = GetCloudDensityHighSensitivity(CurrentPos, Time);

        if (Density > 0.001f)
        {
            float LightStepSize = 3000.0f;
            int LightMaxSteps = 3;
            float LightDensityAccum = 0.0f;

            for (int j = 1; j <= LightMaxSteps; j++)
            {
                float3 LightSamplePos = CurrentPos + LightDirNorm * (j * LightStepSize);
                LightDensityAccum += GetCloudDensityHighSensitivity(LightSamplePos, Time);
            }

            float LightTransmittance = exp(-LightDensityAccum * 2.0f);
            float3 DirectLight = LightColor.rgb * LightTransmittance * PhaseFunction;
            float3 IndirectLight = lerp(ShadowColor, AmbientLight, LightTransmittance);
            float3 StepColor = (DirectLight + IndirectLight) * MyColor.rgb;

            float StepTransmittance = exp(-Density * StepSize * 0.0001f);
            FinalColor += saturate(StepColor) * Density * Transmittance * StepSize * 0.0001f;
            Transmittance *= StepTransmittance;

            if (Transmittance < 0.01f)
                break;
        }
    }

    float CloudAlpha = saturate(1.0f - Transmittance);
    FinalColor = saturate(FinalColor);

    // カラーとアルファを正しく出力
    OutColor = float4(FinalColor * CloudAlpha, CloudAlpha);
}